{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Authority": "http://localhost:8181/auth/realms/master", // Для внешнего доступа
    "InternalAuthority": "http://keycloak:8080/auth/realms/master", // Для внутреннего
    "Audience": "account-service-client",
    "Secret": "YourVeryStrongSecretKeyAtLeast32CharsLong"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=db;Database=account_service;Username=postgres;Password=${DB_PASSWORD}"
  },
  "CurrencySettings": {
    "SupportedCurrencies": [ "RUB", "USD", "EUR", "GBP", "CNY" ],
    "DefaultCurrency": "RUB",
    "MaxInterestRate": 100,
    "Precision": 2
  },
  "CurrencyRates": {
    "USD": 90.50,
    "EUR": 100.20,
    "GBP": 115.75
  }
  //"JwtSettings": {
  //  "SecretKey": "YourVeryStrongSecretKeyAtLeast32CharsLong",
  //  "Issuer": "http://keycloak:8080/realms/account-service",
  //  "Audience": "account-service-client"
  //},

}
